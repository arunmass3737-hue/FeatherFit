# ==============================================================================
# FEATHER FITS — HOSTINGER PRODUCTION APACHE CONFIGURATION
# ==============================================================================

# 1. Force index.php as default homepage (Ignore any .html files)
DirectoryIndex index.php index.php7 index.phtml

# 2. Enable UTF-8 default charset
AddDefaultCharset UTF-8

# 3. Prevent directory listing (browsing files like folder tree)
Options -Indexes

# 4. Security: Block direct browser access to database dumps, data json, and credentials
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Protect sensitive directories from public web downloads
  RewriteRule ^(data|config|database)/ - [F,L,NC]
  
  # Protect sensitive file extensions (.sql, .json files in root)
  RewriteRule \.(sql|env|json|log)$ - [F,L,NC]
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Gzip Compression for Fast Page Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>
